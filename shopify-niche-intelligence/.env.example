# Shopify Niche Intelligence - Environment Variables
# Copy this file to .env and fill in your API keys

# Optional: SerpAPI for enhanced search (https://serpapi.com)
SERP_API_KEY=

# Optional: Google Custom Search API
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Optional: Request timeout in seconds
REQUEST_TIMEOUT=30

# Optional: Max concurrent requests
MAX_CONCURRENT_REQUESTS=5

# Optional: Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600
